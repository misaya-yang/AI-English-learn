# Supabase Configuration
# Get these values from your Supabase Dashboard:
# 1. Go to https://app.supabase.com
# 2. Select your project
# 3. Go to Project Settings > API
# 4. Copy the URL and anon/public key

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...
VITE_APP_BASE_URL=http://localhost:5173

# Production browser builds use the Vercel proxy at /api/supabase by default,
# so users do not connect to *.supabase.co directly.
# VITE_SUPABASE_PROXY_PATH=/api/supabase
# VITE_SUPABASE_PROXY_DISABLED=false

# Local-only escape hatch for maintainers. Leave unset in Vercel Preview and Production.
# When true and the Supabase URL/key above are both missing, the app uses the shared dev project.
# VITE_ALLOW_SUPABASE_DEV_FALLBACK=false
